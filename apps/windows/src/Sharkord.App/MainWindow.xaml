<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sharkord.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="cove">

    <Grid x:Name="RootGrid" Padding="0" Background="#313338">
        <Grid.Resources>
            <Color x:Key="SystemAccentColor">#5865F2</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#5865F2" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#5865F2" />
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
        </Grid.Resources>
        <Grid x:Name="ConnectScreen" Background="#1E1F22" RequestedTheme="Dark">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                MaxWidth="480"
                Background="#2B2D31"
                BorderBrush="#3F4147"
                BorderThickness="1"
                CornerRadius="20"
                Padding="28">
                <StackPanel x:Name="ConnectPanel" Spacing="18">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Border
                            Width="88"
                            Height="88"
                            Background="#22283A"
                            CornerRadius="14">
                            <Grid>
                                <Image
                                    x:Name="ServerLogoImage"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed"
                                    ImageFailed="OnServerLogoFailed" />
                                <TextBlock
                                    x:Name="ServerLogoFallback"
                                    FontSize="46"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock
                            x:Name="ServerTitleText"
                            FontSize="22"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ServerDescriptionText"
                            MaxWidth="340"
                            FontSize="13"
                            Opacity="0.68"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBox x:Name="HostBox" PlaceholderText="localhost:4991" TextChanged="OnHostTextChanged" />
                        <TextBox x:Name="IdentityBox" />
                        <PasswordBox x:Name="PasswordBox" />
                        <CheckBox x:Name="RememberLoginBox" />
                    </StackPanel>

                    <Expander x:Name="AdvancedOptionsExpander">
                        <Expander.Header>
                            <TextBlock x:Name="AdvancedOptionsText" />
                        </Expander.Header>
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <PasswordBox x:Name="ServerPasswordBox" />
                            <TextBox x:Name="InviteBox" />
                        </StackPanel>
                    </Expander>

                    <Button
                        x:Name="ConnectButton"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="OnConnectClick" />
                    <ProgressRing x:Name="ConnectProgress" IsActive="False" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ConnectError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24,0,24,24">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Spacing="14">
                    <HyperlinkButton x:Name="GitHubLink" NavigateUri="https://github.com/sharkord/sharkord" />
                    <HyperlinkButton x:Name="SharkordLink" NavigateUri="https://sharkord.com" />
                </StackPanel>
                <StackPanel
                    x:Name="LoginActionsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="8">
                    <ComboBox
                        x:Name="LoginLanguageBox"
                        Width="180"
                        SelectionChanged="OnLanguageSelectionChanged" />
                    <Button x:Name="LoginExportLogsButton" Click="OnExportLogsClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="ChatPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="MemberColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Background="#2B2D31">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#1E1F22" BorderThickness="0,0,0,1" Padding="16,0">
                    <TextBlock x:Name="ServerNameText" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <TreeView x:Name="ChannelList" Grid.Row="1" Margin="4,8" SelectionMode="Single"
                          Expanding="OnChannelTreeExpanding" Collapsed="OnChannelTreeCollapsed" ItemInvoked="OnChannelInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content.Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <Grid x:Name="UserPanel" Grid.Row="2" Background="#232428" Padding="8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture x:Name="OwnAvatar" Width="32" Height="32" />
                    <TextBlock x:Name="OwnNameText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" />
                    <Button x:Name="UserMicrophoneButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnMicrophoneClick"><FontIcon x:Name="UserMicrophoneIcon" Glyph="&#xE720;" FontSize="16" /></Button>
                    <Button x:Name="UserDeafenButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="OnDeafenClick"><FontIcon x:Name="UserDeafenIcon" Glyph="&#xE7F6;" FontSize="16" /></Button>
                    <Button x:Name="SettingsButton" Click="OnSettingsClick" Grid.Column="4" Style="{StaticResource IconButtonStyle}" />
                </Grid>
            </Grid>

            <Grid x:Name="TextChannelPanel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#1E1F22" BorderThickness="0,0,0,1" Padding="20,0">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CloseThreadButton" Click="OnCloseThreadClick" Visibility="Collapsed"><FontIcon Glyph="&#xE72B;" /></Button><Button x:Name="ReturnToPresentButton" Click="OnReturnToPresentClick" Visibility="Collapsed"><FontIcon Glyph="&#xE74B;" /></Button><TextBlock x:Name="ChannelTitle" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="260" TextTrimming="CharacterEllipsis" /></StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button x:Name="LoadOlderButton" Click="OnLoadOlderClick" HorizontalAlignment="Center" Margin="0,8" />
                    <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" Padding="0,4,0,12" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,2" PointerEntered="OnMessagePointerEntered" PointerExited="OnMessagePointerExited" GotFocus="OnMessageGotFocus" LostFocus="OnMessageLostFocus" Background="Transparent">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Visibility="{Binding DividerVisibility}" Margin="0,12,0,8">
                                        <Border Height="1" Background="#F23F43" VerticalAlignment="Center" />
                                        <Border Background="#313338" Padding="8,0" HorizontalAlignment="Center"><TextBlock Text="{Binding DividerText}" Foreground="#F23F43" FontSize="12" FontWeight="SemiBold" /></Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="{Binding RowMargin}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <PersonPicture Width="40" Height="40" DisplayName="{Binding Author}" ProfilePicture="{Binding Avatar}" Visibility="{Binding GroupHeaderVisibility}" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding ShortTimestamp}" Visibility="{Binding ContinuationTimestampVisibility}" Foreground="#949BA4" FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding GroupHeaderVisibility}">
                                                <HyperlinkButton Content="{Binding Author}" Click="OnMessageProfileClick" Padding="0" />
                                                <TextBlock Text="{Binding Timestamp}" Foreground="#949BA4" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <HyperlinkButton Content="{Binding ReplyText}" Visibility="{Binding ReplyVisibility}" Click="OnReplyPreviewClick" Padding="0" HorizontalAlignment="Left" />
                                            <RichTextBlock FontSize="15" LineHeight="22" TextWrapping="Wrap" IsTextSelectionEnabled="True" Loaded="OnRichMessageLoaded" DataContextChanged="OnRichMessageDataContextChanged" />
                                            <TextBlock Text="{Binding EditedLabel}" Visibility="{Binding EditedVisibility}" Foreground="#949BA4" FontSize="11" />
                                            <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Loaded="OnAttachmentLoaded" DataContextChanged="OnAttachmentDataContextChanged" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Reactions}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><ToggleButton AutomationProperties.Name="{Binding Label}" ToolTipService.ToolTip="{Binding Details}" IsChecked="{Binding Mine, Mode=OneWay}" Click="OnReactionClick" Padding="6,2" MinHeight="24"><StackPanel Orientation="Horizontal" Spacing="4"><Image Source="{Binding Image}" Width="20" Height="20" Visibility="{Binding ImageVisibility}"/><TextBlock Text="{Binding Display}" VerticalAlignment="Center"/></StackPanel></ToggleButton></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border x:Name="MessageToolbar" Grid.ColumnSpan="2" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2B2D31" BorderBrush="#1E1F22" BorderThickness="1" CornerRadius="6" Margin="0,-12,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="{Binding AddReactionLabel}" ToolTipService.ToolTip="{Binding AddReactionLabel}" Click="OnAddReactionClick"><FontIcon Glyph="&#xE76E;" FontSize="16" /></Button>
                                                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="{Binding ReplyLabel}" ToolTipService.ToolTip="{Binding ReplyLabel}" Click="OnReplyMessageClick"><FontIcon Glyph="&#xE97A;" FontSize="16" /></Button>
                                                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="{Binding EditLabel}" ToolTipService.ToolTip="{Binding EditLabel}" Visibility="{Binding EditVisibility}" Click="OnEditMessageClick"><FontIcon Glyph="&#xE70F;" FontSize="16" /></Button>
                                                <Button Content="{Binding ThreadLabel}" Click="OnThreadClick" Visibility="{Binding ThreadVisibility}" />
                                                <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="{Binding MoreLabel}" ToolTipService.ToolTip="{Binding MoreLabel}" Click="OnMessageMoreClick"><FontIcon Glyph="&#xE712;" FontSize="16" /></Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <TextBlock x:Name="ChatErrorText" Grid.Row="2" Margin="20,0" Foreground="#F23F43" TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Margin="16,8,16,0" Spacing="4">
                    <Grid x:Name="ComposerContext" Visibility="Collapsed" Background="#2B2D31" Padding="12,6" CornerRadius="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ComposerContextText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="CancelComposerButton" Grid.Column="1" Click="OnCancelComposerClick" Style="{StaticResource IconButtonStyle}"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                    </Grid>
                    <Button x:Name="ComposerFormatButton" Click="OnComposerFormatClick" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8D2;"/></Button>
                    <StackPanel x:Name="UploadStatusPanel" Visibility="Collapsed" Spacing="4"><TextBlock x:Name="UploadStatusText" TextWrapping="Wrap"/><ProgressBar x:Name="UploadProgressBar" Minimum="0" Maximum="100"/><Button x:Name="CancelUploadButton" Click="OnCancelUploadClick"/></StackPanel>
                    <ItemsControl x:Name="PendingAttachmentList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><Image Source="{Binding Preview}" MaxWidth="80" MaxHeight="60"/><Button Content="{Binding Name}" AutomationProperties.Name="{Binding RemoveLabel}" Click="OnRemoveAttachmentClick" Margin="0,0,0,4" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Grid Background="#383A40" CornerRadius="8" Padding="4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="AttachButton" Style="{StaticResource IconButtonStyle}" Click="OnAttachClick" VerticalAlignment="Bottom"><FontIcon Glyph="&#xE898;" FontSize="20" /></Button>
                        <TextBox x:Name="ComposerBox" Grid.Column="1" Background="Transparent" BorderThickness="0" AcceptsReturn="True" MaxHeight="180" TextWrapping="Wrap" KeyDown="OnComposerKeyDown" TextChanged="OnComposerTextChanged" AllowDrop="True" DragOver="OnComposerDragOver" Drop="OnComposerDrop" Paste="OnComposerPaste" />
                        <Button x:Name="ComposerEmojiButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnComposerEmojiClick" VerticalAlignment="Bottom"><FontIcon Glyph="&#xE76E;" FontSize="20" /></Button>
                        <Button x:Name="SendButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnSendClick" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock x:Name="TypingText" MinHeight="24" Foreground="#B5BAC1" FontSize="12" Margin="8,0" />
                </StackPanel>
            </Grid>

            <Grid x:Name="VoiceChannelPanel" Grid.Column="1" Margin="20,56,20,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="240" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="VoiceChannelTitle" FontWeight="SemiBold" FontSize="18" CharacterSpacing="10" Margin="0,0,0,10" />
                <WebView2
                    x:Name="VoiceMediaWebView"
                    x:Load="False"
                    Grid.Row="1"
                    Loaded="OnVoiceMediaWebViewLoaded" />
                <TextBlock
                    x:Name="VoiceStatusText"
                    Grid.Row="2"
                    Margin="0,8,0,2"
                    FontSize="13"
                    CharacterSpacing="8"
                    TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Spacing="10" VerticalAlignment="Top">
                    <TextBlock x:Name="VoiceErrorText" Foreground="IndianRed" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="JoinVoiceButton" Click="OnJoinVoiceClick" />
                        <Button x:Name="MicrophoneButton" Click="OnMicrophoneClick" Visibility="Collapsed" />
                        <Button x:Name="DeafenButton" Click="OnDeafenClick" Visibility="Collapsed" />
                        <Button x:Name="WebcamButton" Click="OnWebcamClick" Visibility="Collapsed" />
                        <Button x:Name="LeaveVoiceButton" Click="OnLeaveVoiceClick" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="MemberPanel" Grid.Column="2" Background="#2B2D31" Margin="0,48,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="MembersTitle" Margin="16,20,12,8" FontSize="12" Foreground="#B5BAC1" FontWeight="SemiBold" />
                <ListView x:Name="MemberList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnMemberProfileClick">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid Padding="4,6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <PersonPicture DisplayName="{Binding Name}" ProfilePicture="{Binding Avatar}" Width="32" Height="32" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Status}" FontSize="11" Foreground="#949BA4" /></StackPanel>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <StackPanel
            x:Name="TopActionsPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="8"
            Margin="12,8,12,0">
            <ComboBox
                x:Name="LanguageBox"
                Width="150"
                SelectionChanged="OnLanguageSelectionChanged" />
            <Button x:Name="NavigationButton" Click="OnNavigationClick"><FontIcon Glyph="&#xE721;" /></Button>
            <Button x:Name="MembersButton" Click="OnMembersClick" />
            <Button
                x:Name="ExportLogsButton"
                Click="OnExportLogsClick" />
        </StackPanel>
    </Grid>
</Window>
