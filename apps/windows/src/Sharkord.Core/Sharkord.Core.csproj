<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Sharkord.Core</RootNamespace>
    <AssemblyName>Sharkord.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharkord.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- embedded so the tables travel inside the assembly: no output-copy step to get wrong
         and no path to resolve at runtime. the layout mirrors apps/macos/Resources/locales. -->
    <EmbeddedResource Include="I18n/locales/**/*.json" />
  </ItemGroup>

</Project>
