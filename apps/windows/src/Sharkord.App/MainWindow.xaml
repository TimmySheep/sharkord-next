<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sharkord.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="cove">

    <Grid x:Name="RootGrid" Padding="24">
        <StackPanel
            x:Name="ConnectPanel"
            Width="360"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock Text="cove" FontSize="28" FontWeight="Bold" />
            <TextBlock x:Name="TaglineText" Opacity="0.6" />
            <!-- the placeholder shows a host:port example, so it stays untranslated -->
            <TextBox x:Name="HostBox" PlaceholderText="localhost:4991" />
            <TextBox x:Name="IdentityBox" />
            <PasswordBox x:Name="PasswordBox" />
            <PasswordBox x:Name="ServerPasswordBox" />
            <TextBox x:Name="InviteBox" />
            <Button
                x:Name="ConnectButton"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnConnectClick" />
            <ProgressRing x:Name="ConnectProgress" IsActive="False" />
            <TextBlock x:Name="ConnectError" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="ChatPanel" Margin="0,56,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="ServerNameText"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Margin="0,0,0,8" />
                <TreeView
                    x:Name="ChannelList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    Expanding="OnChannelTreeExpanding"
                    Collapsed="OnChannelTreeCollapsed"
                    ItemInvoked="OnChannelInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding Content.Name}"
                                FontSize="14"
                                CharacterSpacing="12"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <Grid x:Name="TextChannelPanel" Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ChannelTitle" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />

                <ListView x:Name="MessageList" Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4" Padding="8,6">
                                <TextBlock
                                    Text="{Binding Text}"
                                    FontSize="15"
                                    CharacterSpacing="12"
                                    LineHeight="23"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ItemsControl ItemsSource="{Binding Reactions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    AutomationProperties.Name="{Binding Label}"
                                                    Content="{Binding Label}"
                                                    IsChecked="{Binding Mine, Mode=OneWay}"
                                                    Click="OnReactionClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        AutomationProperties.Name="{Binding AddReactionLabel}"
                                        Content="{Binding AddReactionGlyph}"
                                        Click="OnAddReactionClick" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="ChatErrorText"
                    Grid.Row="2"
                    Foreground="Red"
                    TextWrapping="Wrap" />

                <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ComposerBox"
                        KeyDown="OnComposerKeyDown" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSendClick" />
                </Grid>
            </Grid>

            <Grid x:Name="VoiceChannelPanel" Grid.Column="1" Margin="16,0,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="240" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="VoiceChannelTitle" FontWeight="SemiBold" FontSize="18" CharacterSpacing="10" Margin="0,0,0,10" />
                <WebView2
                    x:Name="VoiceMediaWebView"
                    Grid.Row="1"
                    Loaded="OnVoiceMediaWebViewLoaded" />
                <TextBlock
                    x:Name="VoiceStatusText"
                    Grid.Row="2"
                    Margin="0,8,0,2"
                    FontSize="13"
                    CharacterSpacing="8"
                    TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Spacing="10" VerticalAlignment="Top">
                    <TextBlock x:Name="VoiceErrorText" Foreground="IndianRed" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="JoinVoiceButton" Click="OnJoinVoiceClick" />
                        <Button x:Name="MicrophoneButton" Click="OnMicrophoneClick" Visibility="Collapsed" />
                        <Button x:Name="DeafenButton" Click="OnDeafenClick" Visibility="Collapsed" />
                        <Button x:Name="WebcamButton" Click="OnWebcamClick" Visibility="Collapsed" />
                        <Button x:Name="LeaveVoiceButton" Click="OnLeaveVoiceClick" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="8">
            <ComboBox
                x:Name="LanguageBox"
                Width="220"
                SelectionChanged="OnLanguageSelectionChanged" />
            <Button
                x:Name="ExportLogsButton"
                Click="OnExportLogsClick" />
        </StackPanel>
    </Grid>
</Window>
