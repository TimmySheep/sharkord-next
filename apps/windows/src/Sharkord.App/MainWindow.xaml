<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sharkord.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="cove">

    <Grid Padding="24">
        <StackPanel
            x:Name="ConnectPanel"
            Width="360"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock Text="cove" FontSize="28" FontWeight="Bold" />
            <TextBlock x:Name="TaglineText" Opacity="0.6" />
            <!-- the placeholder shows a host:port example, so it stays untranslated -->
            <TextBox x:Name="HostBox" PlaceholderText="localhost:4991" />
            <TextBox x:Name="IdentityBox" />
            <PasswordBox x:Name="PasswordBox" />
            <PasswordBox x:Name="ServerPasswordBox" />
            <TextBox x:Name="InviteBox" />
            <Button
                x:Name="ConnectButton"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnConnectClick" />
            <ProgressRing x:Name="ConnectProgress" IsActive="False" />
            <TextBlock x:Name="ConnectError" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="ChatPanel" Margin="0,56,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="ServerNameText"
                    FontWeight="SemiBold"
                    FontSize="16"
                    Margin="0,0,0,8" />
                <ListView
                    x:Name="ChannelList"
                    Grid.Row="1"
                    DisplayMemberPath="Name"
                    SelectionChanged="OnChannelSelected" />
            </Grid>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ChannelTitle" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />

                <ListView x:Name="MessageList" Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4" Padding="8,6">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ItemsControl ItemsSource="{Binding Reactions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    AutomationProperties.Name="{Binding Label}"
                                                    Content="{Binding Label}"
                                                    IsChecked="{Binding Mine, Mode=OneWay}"
                                                    Click="OnReactionClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        AutomationProperties.Name="{Binding AddReactionLabel}"
                                        Content="{Binding AddReactionGlyph}"
                                        Click="OnAddReactionClick" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="ChatErrorText"
                    Grid.Row="2"
                    Foreground="Red"
                    TextWrapping="Wrap" />

                <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ComposerBox"
                        KeyDown="OnComposerKeyDown" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSendClick" />
                </Grid>
            </Grid>
        </Grid>

        <ComboBox
            x:Name="LanguageBox"
            Width="220"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            SelectionChanged="OnLanguageSelectionChanged" />
    </Grid>
</Window>
