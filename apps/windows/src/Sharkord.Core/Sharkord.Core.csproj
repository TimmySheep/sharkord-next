<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Sharkord.Core</RootNamespace>
    <AssemblyName>Sharkord.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharkord.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- embedded so the tables travel inside the assembly: no output-copy step to get wrong
         and no path to resolve at runtime. the layout mirrors apps/macos/Resources/locales. -->
    <EmbeddedResource Include="I18n/locales/**/*.json" />
    <EmbeddedResource
      Include="../../../macos/Resources/locales/**/*.json"
      Exclude="../../../macos/Resources/locales/**/windows.json;../../../macos/Resources/locales/**/connect.json">
      <Link>I18n/locales/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
